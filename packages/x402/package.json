{
  "name": "@wono/x402",
  "version": "0.1.0",
  "private": true,
  "description": "Pay-per-call APIs with HTTP 402 and Wono invoices: a server paywall and a client fetch that pays any token via Aurora Intents.",
  "homepage": "https://wono.fi",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./solana": {
      "types": "./dist/solana.d.ts",
      "default": "./dist/solana.js"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@wono/sdk": "0.2.0"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.95.0"
  },
  "peerDependenciesMeta": {
    "@solana/web3.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solana/web3.js": "^1.99.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
