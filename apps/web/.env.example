# Required. Aurora Intents application key (studio.aurora.dev). Server-only.
WONO_AURORA_API_KEY=

# Public origin used in checkout links and embed snippets, e.g. https://wono.fi
WONO_PUBLIC_URL=

# MongoDB connection string (a replica set, e.g. MongoDB Atlas, so transactions work). Database name: MONGODB_DB, default "wono".
MONGODB_URI=

# Chain RPC overrides. Defaults are public endpoints with strict rate limits;
# use a dedicated Solana RPC (Helius, Triton, QuickNode…) in production.
WONO_RPC_SOL=
WONO_RPC_BASE=
WONO_RPC_ETH=
WONO_RPC_ARB=
WONO_RPC_OP=
WONO_RPC_POL=
WONO_RPC_BSC=
WONO_RPC_AVAX=

# Optional: Solana wallet that pays customers' network fees and token-account rent.
# 64-byte secret key (base58 or solana-keygen JSON array). Keep it funded with a little SOL;
# below 0.01 SOL customers pay their own fees. Generate: solana-keygen new -o sponsor.json
WONO_SOLANA_FEE_PAYER_SECRET=
